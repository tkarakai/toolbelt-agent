{
  "formatVersion": 1,
  "id": "agent",
  "name": "Agent",
  "description": "Ask an AI agent about your tools: an ask bar that grows into a chat over whatever screen you're on. Uses Claude Code, Codex, Gemini CLI or another ACP agent with your own login.",
  "icon": "sparkles",
  "version": "0.1.0",
  "protocol": 2,
  "agent": {
    "access": "none"
  },
  "entry": "index.js",
  "repo": "tkarakai/toolbelt-agent",
  "requires": {
    "host": ">=0.7.1",
    "bun": ">=1.3.0",
    "platforms": [
      "portable"
    ]
  },
  "capabilities": {
    "required": [
      "ui.core",
      "ui.conversation",
      "ui.composer",
      "ui.rich-fields",
      "ui.floating"
    ],
    "optional": []
  },
  "data": {
    "schema": 1
  },
  "screens": [],
  "floating": {
    "shortcut": "k"
  }
}
