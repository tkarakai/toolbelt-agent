{
  "name": "toolbelt-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Ask an AI agent about your tools from a floating ask bar. A Toolbelt plugin.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "package": "bun scripts/package.ts",
    "release:plugin": "bun run --bun toolbelt-release plugin",
    "release:plugin:retry": "bun run --bun toolbelt-release plugin:retry"
  },
  "dependencies": {
    "@toolbelt/sdk": "https://github.com/tkarakai/toolbelt/releases/download/sdk-v0.5.1/toolbelt-sdk-0.5.1.tgz"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "~7.0.2"
  }
}
